# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Pick which provider to use: groq or openrouter
PAFA_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/openai/gpt-4o-mini

# How many times to repeat each (condition, task) pair
PAFA_REPEATS=2
